# Скопируй в .env (для `docker compose` на хосте) или задай эти же переменные
# в секции Environment variables стека Portainer.

# Каталог сокетов живой сессии (PipeWire + Wayland)
XDG_RUNTIME_DIR=/run/user/1000

# Имя Wayland-сокта: у KDE Plasma обычно wayland-1, у wlroots-сессий wayland-0
WAYLAND_DISPLAY=wayland-1

# Какие ggml/Vulkan-устройства видеть внутри контейнера (0 = первый в перечислении ggml)
GGML_VK_VISIBLE_DEVICES=0

# Если запускать контейнер от своего пользователя, а не от root
HOST_UID=1000
HOST_GID=1000

IMAGE=dicta:local
