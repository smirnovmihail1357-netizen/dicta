[Unit]
# клавишу жмут часто: не считать это «повторными сбоями»
StartLimitIntervalSec=0
Description=Dicta: начать или закончить диктовку (окно %i)

[Service]
Type=oneshot
# %i — имя фокусного окна, его подставляет KWin-скрипт (dicta-toggle@konsole.service)
ExecStart=%h/.local/bin/dictactl toggle --app %i
